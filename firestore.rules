rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function unchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function followCountDeltaOk() {
      let before = resource.data;
      let after = request.resource.data;
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      let followersDelta = after.followersCount - before.followersCount;
      let followingDelta = after.followingCount - before.followingCount;
      return keys.hasOnly(['followersCount', 'followingCount', 'updatedAt'])
        && (followersDelta == 0 || followersDelta == 1 || followersDelta == -1)
        && (followingDelta == 0 || followingDelta == 1 || followingDelta == -1)
        && !(followersDelta == 0 && followingDelta == 0);
    }

    function reputationAwardOk() {
      let before = resource.data;
      let after = request.resource.data;
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      let delta = after.reputationPoints - before.reputationPoints;
      return keys.hasOnly(['reputationPoints', 'reputationLevel', 'updatedAt'])
        && delta > 0
        && delta <= 25
        && (
          (after.reputationPoints < 100 && after.reputationLevel == 'beginner')
          || (after.reputationPoints >= 100 && after.reputationPoints < 400
            && after.reputationLevel == 'activeHunter')
          || (after.reputationPoints >= 400 && after.reputationPoints < 1000
            && after.reputationLevel == 'trustedHunter')
          || (after.reputationPoints >= 1000
            && after.reputationLevel == 'fieldExpert')
        );
    }

    // --- users ---
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isSelf(userId)
        && request.resource.data.keys().hasAll([
          'displayName', 'username', 'usernameLower', 'country', 'region',
          'onboardingComplete', 'reputationPoints', 'isAdmin'
        ])
        && request.resource.data.isAdmin == false
        && request.resource.data.reputationPoints == 0;
      allow update: if (isSelf(userId)
          && unchanged(['isAdmin', 'reputationPoints', 'reputationLevel',
            'followersCount', 'followingCount', 'createdAt', 'username',
            'usernameLower'])
        ) || (signedIn() && followCountDeltaOk())
        || (signedIn() && reputationAwardOk())
        || isAdmin();
      allow delete: if isAdmin();
    }

    // Username reservation map for uniqueness checks
    match /usernames/{usernameLower} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // --- posts ---
    match /posts/{postId} {
      function postEngagementCountOk() {
        let before = resource.data;
        let after = request.resource.data;
        let keys = request.resource.data.diff(resource.data).affectedKeys();
        let likeDelta = after.likeCount - before.likeCount;
        let commentDelta = after.commentCount - before.commentCount;
        return keys.hasOnly(['likeCount', 'commentCount', 'updatedAt'])
          && (likeDelta == 0 || likeDelta == 1 || likeDelta == -1)
          && (commentDelta == 0 || commentDelta == 1 || commentDelta == -1)
          && !(likeDelta == 0 && commentDelta == 0);
      }

      allow read: if signedIn() && (
        resource.data.isDeleted != true
        || resource.data.authorId == request.auth.uid
        || isAdmin()
      );
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'authorId', 'country', 'region', 'caption', 'createdAt'
        ]);
      allow update: if signedIn() && (
        resource.data.authorId == request.auth.uid
        || isAdmin()
        || postEngagementCountOk()
      );
      allow delete: if isAdmin()
        || (signedIn() && resource.data.authorId == request.auth.uid);

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if signedIn()
          && (resource.data.authorId == request.auth.uid || isAdmin());
      }

      match /likes/{likerId} {
        allow read: if signedIn();
        allow create, delete: if isSelf(likerId);
      }

      match /saves/{saverId} {
        allow read: if signedIn();
        allow create, delete: if isSelf(saverId);
      }
    }

    // --- follows: doc id = {followerId}_{followingId} ---
    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId is string
        && request.resource.data.followerId != request.resource.data.followingId
        && followId == request.resource.data.followerId + '_' + request.resource.data.followingId;
      allow delete: if signedIn()
        && resource.data.followerId == request.auth.uid;
    }

    // --- field reports ---
    match /field_reports/{reportId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'authorId', 'country', 'region', 'area', 'reportDate', 'createdAt'
        ]);
      allow update, delete: if signedIn()
        && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // --- hunting locations ---
    match /hunting_locations/{locationId} {
      allow read: if signedIn() && (
        (resource.data.status == 'approved'
          && resource.data.visibility == 'community')
        || resource.data.proposedBy == request.auth.uid
        || isAdmin()
      );
      allow create: if signedIn()
        && request.resource.data.proposedBy == request.auth.uid
        && (
          request.resource.data.status == 'pending'
          || (isAdmin() && request.resource.data.status == 'approved')
        );
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.proposedBy == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'pending');
      allow delete: if isAdmin();
    }

    // --- marketplace ---
    match /marketplace_listings/{listingId} {
      allow read: if signedIn() && resource.data.isRemoved != true;
      allow create: if signedIn()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.isRemoved == false;
      allow update, delete: if signedIn()
        && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    // --- messaging ---
    match /conversations/{conversationId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds.size() == 2;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasAll(['senderId', 'text', 'createdAt'])
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow update, delete: if false;
      }
    }

    // --- notifications ---
    match /notifications/{notificationId} {
      allow read, update: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId is string
        && request.resource.data.keys().hasAll([
          'userId', 'type', 'title', 'createdAt', 'read'
        ]);
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    // --- badges (admin-managed definitions) ---
    match /badges/{badgeId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /user_badges/{userBadgeId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        || (signedIn() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    // Anti-spam reputation ledger
    match /reputation_awards/{awardId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /reputation_daily/{dailyId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;
    }

    // --- moderation reports ---
    match /moderation_reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
